{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Majarrah Docs",
  "description": "Majarrah platform documentation and Decision API reference.",
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#6366f1",
    "light": "#6366f1",
    "dark": "#4f46e5"
  },
  "background": {
    "decoration": "windows"
  },
  "api": {
    "mdx": {
      "server": "https://api.majarrah.io/v1",
      "auth": {
        "method": "bearer"
      }
    }
  },
